#!/usr/bin/env ruby
# -*- coding: utf-8 -*-
require 'optparse'
require 'colorize'
require 'open3'
require 'pathname'
require 'shellwords'

$stdout.sync = true

def abort_with(message)
  warn message.red
  exit 1
end

def capture_git(*args, chdir: nil)
  command = ['git']
  command.concat(['-C', chdir]) if chdir
  stdout, stderr, status = Open3.capture3(*command, *args)
  [stdout, stderr, status]
end

def repository_root(start_dir = Dir.pwd)
  stdout, _stderr, status = capture_git('rev-parse', '--show-toplevel', chdir: start_dir)
  status.success? ? stdout.strip : nil
end

def current_branch
  stdout, _stderr, status = capture_git('symbolic-ref', '--quiet', '--short', 'HEAD')
  status.success? ? stdout.strip : nil
end

def superproject_root
  stdout, _stderr, status = capture_git('rev-parse', '--show-superproject-working-tree')
  status.success? ? stdout.strip : ''
end

def git_paths(*args)
  stdout, stderr, status = capture_git(*args, '-z')
  abort_with("git #{args.join(' ')} failed:\n#{stderr}") unless status.success?
  stdout.split("\0").reject(&:empty?)
end

def show_untracked_files
  files = git_paths('ls-files', '--others', '--exclude-standard')
  return if files.empty?

  puts 'CAUTION: git add -A will add these new files:'.yellow
  files.each { |file| puts "  #{file}" }
  puts
end

def check_large_files(size_limit)
  puts "Checking Git-managed files for files larger than #{size_limit}MB...".green
  limit_bytes = size_limit * 1024 * 1024
  files = git_paths('ls-files', '--cached', '--others', '--exclude-standard')
  large_files = files.filter_map do |file|
    stat = File.lstat(file)
    [file, stat.size] if stat.file? && stat.size > limit_bytes
  rescue Errno::ENOENT
    nil
  end

  return if large_files.empty?

  puts "Large files (greater than #{size_limit}MB) detected:".red
  large_files.each do |file, size|
    puts format('  %8.1f MB  %s', size.fdiv(1024 * 1024), file)
  end
  abort_with('Aborting due to large files.')
end

def print_command(command)
  puts Shellwords.join(command).green
  puts
end

def run_command(command)
  print_command(command)
  return if system(*command)

  abort_with("Command failed. Stopping here:\n  #{Shellwords.join(command)}")
end

def show_staged_changes
  stdout, stderr, status = capture_git('diff', '--cached', '--name-status')
  abort_with("Could not inspect staged changes:\n#{stderr}") unless status.success?

  if stdout.empty?
    puts 'Nothing to commit.'.yellow
    puts
    false
  else
    puts 'Changes to be committed:'.green
    puts stdout
    true
  end
end

def run_git_commands(message, branch, dryrun: false)
  commit_command = ['git', 'commit']
  commit_command.concat(['-m', message]) if message
  commands = [
    ['git', 'add', '-A'],
    commit_command,
    ['git', 'pull', '--rebase', 'origin', branch],
    ['git', 'push', 'origin', branch]
  ]

  if dryrun
    commands.each { |command| print_command(command) }
    return
  end

  run_command(commands[0])
  run_command(commands[1]) if show_staged_changes
  run_command(commands[2])
  run_command(commands[3])
end

def show_superproject_notice(superproject, repository)
  return if superproject.empty?

  relative_path = Pathname.new(repository).relative_path_from(Pathname.new(superproject))
  puts
  puts 'This repository is a submodule.'.yellow
  puts "The submodule commit was pushed, but the parent repository still needs to record it:"
  puts "  Parent: #{superproject}"
  puts "  Submodule: #{relative_path}"
  puts "Run auto_git separately from the parent repository after checking its changes."
end

def parse_options
  opts = {}
  OptionParser.new do |parser|
    parser.banner = 'Usage: auto_git [options]'
    parser.on('-d', '--dryrun', 'Show commands without executing them') { opts[:dryrun] = true }
    parser.on('-m MESSAGE', '--message MESSAGE', 'Commit message') { |message| opts[:message] = message }
    parser.on('-s SIZE', '--size SIZE', Integer, 'File size limit in MB (default: 40)') { |size| opts[:size] = size }
  end.parse!
  opts
end

def main
  opts = parse_options
  repository = repository_root
  abort_with('No Git repository found.') unless repository

  Dir.chdir(repository) do
    branch = current_branch
    unless branch
      abort_with(<<~MESSAGE)
        This repository is in detached HEAD state.
        Switch to the branch you want to update, then run auto_git again.
        Example: git switch main
      MESSAGE
    end

    superproject = superproject_root
    puts "Using Git repository: #{repository}".green
    puts "Repository type: #{superproject.empty? ? 'standalone/parent' : 'submodule'}".green
    puts "Current branch: #{branch}".green
    puts

    show_untracked_files
    size_limit = opts.fetch(:size, 40)
    abort_with('File size limit must be greater than zero.') unless size_limit.positive?
    check_large_files(size_limit)
    run_git_commands(opts[:message], branch, dryrun: opts[:dryrun])
    show_superproject_notice(superproject, repository) unless opts[:dryrun]
  end
end

main
